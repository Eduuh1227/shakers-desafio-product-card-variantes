{% assign main_product = all_products['camiseta-padrao'] %}

<div class="product-card" data-product-id="{{ main_product.id }}">

  <img src="{{ main_product.featured_image | image_url: width: 500 }}" alt="{{ main_product.title }}">

  <h3>{{ main_product.title }}</h3>

  <p class="product-price" data-product-price>
    {{ main_product.selected_or_first_available_variant.price | money }}
  </p>

  <label>Cor</label>
  <select class="product-option" data-option-index="0">

    {% for value in main_product.options_with_values[0].values %}
      <option value="{{ value }}">{{ value }}</option>
    {% endfor %}

  </select>


  <label>Tamanho</label>

  <select class="product-option" data-option-index="1">

    {% for value in main_product.options_with_values[1].values %}
      <option value="{{ value }}">{{ value }}</option>
    {% endfor %}

  </select>

  <button class="add-to-cart" data-add-to-cart>Adicionar ao carrinho</button>
  
</div>

<script>
  const productVariants = {{ main_product.variants | json }};
</script>
